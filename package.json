{
  "name": "ipexchange",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm -w apps/web run dev",
    "dev:api": "npm -w apps/api run dev",
    "build": "npm -w apps/web run build",
    "deploy": "npm -w apps/web run build && npm -w apps/api run deploy",
    "db:apply": "node scripts/db-apply.js",
    "db:seed": "node scripts/seed.js"
  },
  "devDependencies": {
    "postgres": "^3.4.5"
  }
}
