{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ipexchange",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/l/*", "/og/*"]
  },
  "observability": {
    "enabled": true
  },
  // Every 6 hours: keeps the Supabase Free project from auto-pausing
  // (it pauses after 7 days without activity). See src/lib/keepalive.js.
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "vars": {
    "BASE_RPC_URL": "https://mainnet.base.org",
    "SOLANA_CLUSTER": "devnet"
  },
  "routes": [
    { "pattern": "ipexchange.xyz", "custom_domain": true },
    { "pattern": "xchange.synapses.academy", "custom_domain": true }
  ]
  // Secrets (wrangler secret bulk): SUPABASE_URL, SUPABASE_SECRET_KEY,
  // GEMINI_API_KEY, GROQ_API_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET,
  // PRIVY_APP_ID, PRIVY_APP_SECRET, LINK_TOKEN_SECRET, TELEGRAM_BOT_USERNAME
  // PRIVY_APP_SECRET is required: payout wallet verification (POST /me/wallet)
  // fails closed without it.
  // Optional: SOLANA_ANCHOR_SECRET signs loop receipts and anchors their Merkle
  // root in a Solana Memo transaction (base58 64-byte key or CLI JSON array; the
  // keypair must hold a little SOL). Without it receipts stay unsigned and
  // nothing is anchored. SOLANA_RPC_URL is a secret because provider URLs
  // (Helius, QuickNode) embed an API key; the public devnet RPC is the default
  // but blocks Workers traffic. SOLANA_CLUSTER (devnet, mainnet-beta) is a var
  // above; switch it together with the RPC for mainnet.
  // Optional: ADMIN_EMAILS / ADMIN_TELEGRAM_IDS (comma lists that bootstrap admins)
}
